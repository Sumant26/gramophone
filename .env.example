# Copy this file to .env (or .env.local) and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# Required for YouTube search (Library > YouTube tab).
# Get a free key: console.cloud.google.com -> new project -> enable
# "YouTube Data API v3" -> Credentials -> Create API key.
# For a public deployed app, restrict the key to your site's domain
# (HTTP referrer restriction) in the Google Cloud Console.
VITE_YOUTUBE_API_KEY=
